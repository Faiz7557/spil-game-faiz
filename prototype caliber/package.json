{
  "name": "plantpulse-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed": "tsx --env-file=.env supabase/seed/seed.ts",
    "eval:rca": "tsx --env-file=.env evals/rca-auditor.eval.ts",
    "eval:copilot": "tsx --env-file=.env evals/copilot.eval.ts",
    "eval:evidence": "tsx --env-file=.env evals/evidence-check.eval.ts",
    "eval:diagnosis": "tsx --env-file=.env evals/diagnosis.eval.ts",
    "check:ai": "tsx --env-file=.env scripts/check-openai.ts",
    "check:db": "tsx --env-file=.env scripts/check-supabase.ts",
    "check:live": "tsx --env-file=.env scripts/check-live.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.50.0",
    "openai": "^7.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.32.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.169.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}

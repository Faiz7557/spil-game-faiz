{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?__route=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/due-actions",
      "schedule": "0 23 * * *"
    }
  ],
  "regions": [
    "sin1"
  ]
}

# Copy to prototype/.env and fill in. The same names go into Vercel → Settings → Environment Variables.

# Server only — never prefix these with VITE_
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-6.1-sol for reasoning work, gpt-6-luna for short text)
OPENAI_MODEL=
OPENAI_MODEL_LIGHT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
AI_DAILY_BUDGET_USD=20
# Optional: due-date emails. Leave empty to skip sending.
RESEND_API_KEY=
NOTIFY_FROM=
# "open" = no sign-in during the trial phase; everyone shares one sandbox. "required" = guest / email sign-in.
AUTH_MODE=open

# Browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Must match AUTH_MODE
VITE_AUTH_MODE=open

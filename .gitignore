# Dependencies (Sangat besar dan bisa diunduh ulang via npm install)
node_modules/
**/node_modules/

# Environment Variables / API Keys (Berisi data sensitif & rahasia)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env

# Hasil Build / Output Produksi (Dibuat otomatis saat menjalankan perintah build)
dist/
build/
.next/
out/

# Log Files (Catatan error saat menjalankan npm)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# File Sistem Operasi (Metadata OS)
.DS_Store
Thumbs.db

# Konfigurasi Editor/IDE Pribadi (Opsional)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Dokumen Skripsi & Naskah Pribadi
*skripsi*
*Skripsi*
*.docx
# Port server backend game SPIL
PORT=5050

# URL Koneksi Database PostgreSQL Anda
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spil_game

# Set ke true jika menggunakan koneksi SSL (misal: di Heroku/Render)
DATABASE_SSL=false

# Secret untuk menandatangani token login (JWT). WAJIB diisi nilai acak yang
# panjang & rahasia di production - jangan gunakan nilai default/contoh ini.
JWT_SECRET=change-this-to-a-long-random-secret-in-production

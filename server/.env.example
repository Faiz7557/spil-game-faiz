# Port server backend game SPIL
PORT=5050
NODE_ENV=development

# URL Koneksi Database PostgreSQL Anda
# Format A: DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spil_game

# Format B: Parameter terpisah (jika DATABASE_URL tidak diisi)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spil_game
DB_POOL_MAX=20

# Set ke true jika menggunakan koneksi SSL (misal: di AWS/Heroku/Render)
DATABASE_SSL=false

# Redis Configuration (Optional: Otomatis beralih ke in-memory store jika kosong)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI Microservice URL (FastAPI / Bot Omega DRL)
AI_SERVICE_URL=http://localhost:8000

# CORS Whitelist (Gunakan koma untuk beberapa domain, atau * untuk development)
CORS_ORIGIN=*

# Secret untuk menandatangani token login (JWT). WAJIB diisi nilai acak yang
# panjang & rahasia di production - generate dengan:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ===================================================
# SPIL-GAME production config for docker-compose.yml
# Copy to .env and fill in. Never commit .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===================================================

# Public domain served by Caddy (automatic HTTPS). Use localhost for a local test.
DOMAIN=localhost

# Database (PostgreSQL) - password is required, compose refuses to start without it
POSTGRES_USER=spil_admin
POSTGRES_PASSWORD=
POSTGRES_DB=spil_game
DB_POOL_MAX=10

# Login token signing key - required
JWT_SECRET=

# Leave empty: the client is served from the same origin as the API.
# Only set (comma-separated https origins) if another site must call the API.
CORS_ORIGIN=

# ===================================================
# SPIL-GAME Full-Stack Environment Configuration
# ===================================================

# Database (PostgreSQL)
POSTGRES_USER=spil_admin
POSTGRES_PASSWORD=spil_secret_password_change_in_production
POSTGRES_DB=spil_game
DB_HOST=postgres
DB_PORT=5432
DB_POOL_MAX=20

# Redis In-Memory Store & Pub/Sub
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Server & Authentication
PORT=5050
NODE_ENV=production
CORS_ORIGIN=*
# Generate production key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=spil_production_jwt_secret_key_must_be_changed_in_prod

# AI Microservice (Bot Omega Inference)
AI_SERVICE_URL=http://ai-service:8000

# Client Vite API Base URL (leave empty for automatic same-origin proxy in Docker)
VITE_API_URL=
